<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GuildCopilot-Installer</AssemblyName>
    <RootNamespace>GuildCopilot.Installer</RootNamespace>
    <Version>1.0.7</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Eigene Zaehlung: der Installer wird unabhaengig vom Addon versioniert. -->
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Dateisymbol im Explorer. Das Fenstersymbol kommt weiterhin aus dem
         eingebetteten PNG; fuer die Datei selbst braucht Windows aber eine
         echte .ico mit mehreren Groessen, sonst skaliert der Explorer ein
         einzelnes Bild hoch und es sieht ausgefranst aus. -->
    <ApplicationIcon>Assets\GuildCopilot.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\GuildCopilotLogo.png" />
  </ItemGroup>

</Project>
