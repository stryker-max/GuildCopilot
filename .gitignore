*.zip
Thumbs.db
.DS_Store
.idea/
.vscode/

# Abhaengigkeiten der Testwerkzeuge. Festgeschrieben wird in package-lock.json,
# installiert mit "npm ci" - der Ordner selbst gehoert nicht ins Repository.
node_modules/

# Staging und Archiv des CurseForge-Pakets. Beides entsteht bei jedem Testlauf
# neu aus dem Ordner GuildCopilot; abgelegt wird nichts davon.
build/


# Build-Ausgabe des Installers
Installer/bin/
Installer/obj/
!Installer/dist/

# Zwischenordner des Publish-Laufs
Installer/publish-tmp/

# Debugsymbole. Ausgeliefert wird nur die .exe; die .pdb entsteht beim Publish
# gleich daneben und gehoert nicht ins Repository.
Installer/dist/*.pdb
